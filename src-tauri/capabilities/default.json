{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "番组课表主窗口使用的最小桌面权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.bgm.tv/**" },
        { "url": "https://cdn.jsdelivr.net/**" },
        { "url": "https://unpkg.com/**" },
        { "url": "https://bgmtimetable.com/**" }
      ]
    }
  ]
}
